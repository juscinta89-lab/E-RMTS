rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Fungsi bantuan
    function isSignedIn() { return request.auth != null; }

    // Profil pengguna disimpan dengan ID dokumen = emel pengguna
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.token.email));
    }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.token.email))
        && profile().data.role in ['Administrator','Guru Besar','PK HEM'];
    }

    // settings & profil sekolah — semua boleh baca, admin sahaja tulis
    match /settings/{doc} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // users — ID dokumen = emel.
    // - Sesiapa boleh cipta profil SENDIRI (untuk pendaftaran/log masuk Google kali pertama)
    // - Admin (Administrator/Guru Besar/PK HEM) mempunyai KUASA PENUH: tambah, edit,
    //   tukar peranan, dan padam mana-mana pengguna
    match /users/{email} {
      allow read:   if isSignedIn();
      allow create: if isAdmin() || (isSignedIn() && request.auth.token.email == email);
      allow update, delete: if isAdmin() || request.auth.token.email == email;
    }

    // classes & students — baca oleh pengguna log masuk; tulis oleh admin
    match /classes/{id} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }
    // students — admin & Guru RMT boleh urus semua.
    // Guru kelas boleh tambah/edit murid KELAS SENDIRI sahaja.
    // Padam dikhaskan kepada admin (memadam murid memusnahkan rekod kehadiran).
    match /students/{id} {
      function guruRMT(){ return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.token.email))
        && profile().data.role == 'Guru RMT'; }
      function kelasSaya(){ return profile().data.kelasId; }
      allow read:   if isSignedIn();
      allow create: if isAdmin() || guruRMT()
        || (isSignedIn() && request.resource.data.kelasId == kelasSaya());
      allow update: if isAdmin() || guruRMT()
        || (isSignedIn() && request.resource.data.kelasId == kelasSaya()
            && resource.data.kelasId == kelasSaya());
      allow delete: if isAdmin();
    }

    // attendance — guru & admin boleh baca/tulis.
    // KUNCI PENGESAHAN: selepas medan `sah` ditetapkan (bulan disahkan guru kelas),
    // hanya admin boleh mengubah dokumen itu (termasuk membuka semula pengesahan).
    match /attendance/{id} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn()
        && (isAdmin() || !('sah' in resource.data) || resource.data.sah == null);
      allow delete: if isAdmin();
    }

    // borang C1 (fizikal) & C2 (akademik) — sama seperti attendance
    match /fizikal/{id} {
      allow read, write: if isSignedIn();
    }
    match /akademik/{id} {
      allow read, write: if isSignedIn();
    }

    // roster snapshot sesi lama — baca semua, tulis admin
    match /rosters/{year} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // holidays & activity_logs
    match /holidays/{id} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }
    match /activity_logs/{id} {
      allow read:  if isAdmin();
      allow create: if isSignedIn();
    }
  }
}
